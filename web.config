<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk Configuration for Node.js Application on Windows Server
  This file configures IIS to route requests to Node.js via iisnode.
-->
<configuration>
  <system.webServer>
    <!-- Map all requests to Node.js server entry point -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Do not interfere with iisnode debugger / inspector requests -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Static content in dist folder -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](html|htm|svg|js|css|png|gif|jpg|jpeg|ico|json|woff|woff2|ttf|eot))" />
          <action type="Rewrite" url="dist/{R:1}" />
        </rule>

        <!-- All other URLs are mapped to Node.js application entry point -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode module configuration for Windows Server performance -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="web.config;*.js;package.json;.env"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="true"
    />

    <!-- Allow detailed error messages to pass through to the browser for easy troubleshooting -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Security: Block sensitive directories and files from direct HTTP access -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".git" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
